# 文颜 CLI 本地部署配置
# 复制此文件为 .env 或 .env.test，并填入你的微信公众号凭证
# 获取方式：微信公众平台 -> 开发 -> 基本配置 -> AppID / AppSecret

# ========== 必填：微信公众号凭证 ==========
WECHAT_APP_ID=你的AppID
WECHAT_APP_SECRET=你的AppSecret

# ========== 可选：Server 模式 ==========
# 启动 Server 时使用的 API 密钥（客户端调用需携带 x-api-key 头）
# WENYAN_API_KEY=your-api-key

# Server 端口（默认 3000）
# PORT=3000

# ========== 可选：Cloudflare Tunnel ==========
# 使用 wenyan serve --tunnel 时，从以下环境变量读取 Cloudflare 凭证
# 也可通过命令行参数覆盖
# CF_API_TOKEN=你的Cloudflare_API_Token
# CF_ACCOUNT_ID=你的Cloudflare_Account_ID
# CF_ZONE_ID=你的域名Zone_ID
# CF_HOSTNAME=wenyan.example.com
